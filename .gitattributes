# 默认把文本规范化为 LF，避免 CRLF/LF 差异被当成改动。
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.conf text eol=lf

# 明确二进制，避免被当成文本做 diff
*.pt binary
*.pth binary
*.onnx binary
*.png binary
*.jpg binary
*.jpeg binary
*.tar binary
*.gz binary
*.zip binary
