  "components": {
    "schemas": {
      "AuthMode": {
        "type": "string",
        "enum": [
          "none",
          "api_key",
          "accounts"
        ],
        "title": "AuthMode"
      },
      "AuthStatusResponse": {
        "properties": {
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          },
          "mode": {
            "$ref": "#/components/schemas/AuthMode",
            "default": "api_key"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "required",
          "authenticated"
        ],
        "title": "AuthStatusResponse"
      },
      "Body_create_evaluation_v1_evaluations_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Image or video file to evaluate"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_create_evaluation_v1_evaluations_post"
      },
      "Body_create_visualization_v1_visualizations_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Image file to visualize"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_create_visualization_v1_visualizations_post"
      },
      "DatasetType": {
        "type": "string",
        "enum": [
          "image",
          "video"
        ],
        "title": "DatasetType"
      },
      "ErrorCode": {
        "type": "integer",
        "enum": [
          1000,
          1001,
          1100,
          1200,
          1201,
          1202,
          1203,
          1300,
          1301,
          1302,
          1303,
          1400,
          1401,
          1402,
          1403,
          1500,
          1501,
          1502,
          1503,
          1504,
          1600,
          1601
        ],
        "title": "ErrorCode",
        "description": "Stable public business error codes, intentionally outside HTTP 100-599."
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable business error code outside the reserved HTTP status range 100-599"
          },
          "error": {
            "type": "string",
            "title": "Error"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "title": "ErrorResponse",
        "example": {
          "code": 1100,
          "error": "Model 'iqa' is not configured"
        }
      },
      "EvaluationResponse": {
        "properties": {
          "evaluation_id": {
            "type": "string",
            "title": "Evaluation Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "media_type": {
            "$ref": "#/components/schemas/DatasetType"
          },
          "task_type": {
            "$ref": "#/components/schemas/TaskType"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "backbone": {
            "type": "string",
            "title": "Backbone"
          },
          "dataset": {
            "type": "string",
            "title": "Dataset"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Normalized predicted quality score"
          },
          "mos_score": {
            "anyOf": [
              {
