    "/v1/evaluations": {
      "post": {
        "tags": [
          "evaluations"
        ],
        "summary": "Evaluate one uploaded image or video",
        "description": "Evaluate one uploaded image or video with the selected quality model.\n\nThe upload is validated and persisted before the model is touched, then\ninference runs inside the heavy-request serialization policy. On success\nthe measured scores and latency are returned; frontend-tagged requests are\nalso appended to the evaluation history store.",
        "operationId": "create_evaluation_v1_evaluations_post",
        "parameters": [
          {
            "name": "model_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Model identifier: iqa or vqa",
              "default": "iqa",
              "title": "Model Id"
            },
            "description": "Model identifier: iqa or vqa"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_evaluation_v1_evaluations_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationResponse"
                }
              }
            }
