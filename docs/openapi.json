{
  "openapi": "3.1.0",
  "info": {
    "title": "Deep-VQA Quality Assessment API",
    "description": "REST API for image and video quality assessment inference.",
    "version": "0.9.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Check service health",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },

    "/v1/auth/status": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Auth Status",
        "operationId": "auth_status_v1_auth_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Auth Login",
        "operationId": "auth_login_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Auth Logout",
        "operationId": "auth_logout_v1_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatusResponse"
                }
              }
            }
          }
        }
      }
    },

    "/v1/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "List loaded quality assessment models",
        "operationId": "list_models_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelCollectionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models/{model_id}": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "Get one loaded model",
        "operationId": "get_model_v1_models__model_id__get",
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Model Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelSummary"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },

    "/v1/frontend-evaluations": {
      "get": {
        "tags": [
          "frontend"
        ],
        "summary": "List recent frontend evaluation log records",
        "operationId": "list_frontend_evaluations_v1_frontend_evaluations_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "description": "Maximum number of newest SQLite records to return",
              "default": 100,
              "title": "Limit"
            },
            "description": "Maximum number of newest SQLite records to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontendEvaluationLogResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/subjective-assessments": {
      "post": {
        "tags": [
          "frontend"
        ],
        "summary": "Describe image or video quality with Ollama and calculate a Bayesian assessment",
        "description": "Run an ephemeral Ollama assessment; this route never writes SQLite or JSONL records.",
        "operationId": "create_subjective_assessment_v1_subjective_assessments_post",
        "parameters": [
          {
            "name": "video_frames",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 8,
              "minimum": 1,
              "description": "Evenly sampled frames for video assessment",
              "default": 4,
              "title": "Video Frames"
            },
            "description": "Evenly sampled frames for video assessment"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_subjective_assessment_v1_subjective_assessments_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubjectiveAssessmentResponse"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },

    "/v1/evaluations": {
      "post": {
        "tags": [
          "evaluations"
        ],
        "summary": "Evaluate one uploaded image or video",
        "operationId": "create_evaluation_v1_evaluations_post",
        "parameters": [
          {
            "name": "model_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Serving model role: iqa or vqa",
              "default": "iqa",
              "title": "Model Id"
            },
            "description": "Serving model role: iqa or vqa"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_evaluation_v1_evaluations_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/v1/visualizations": {
      "post": {
        "tags": [
          "visualizations"
        ],
        "summary": "Generate feature maps and Grad-CAM for an image",
        "operationId": "create_visualization_v1_visualizations_post",
        "parameters": [
          {
            "name": "model_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Loaded image model role",
              "default": "iqa",
              "title": "Model Id"
            },
            "description": "Loaded image model role"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_visualization_v1_visualizations_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisualizationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthStatusResponse": {
        "properties": {
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          }
        },
        "type": "object",
        "required": [
          "required",
          "authenticated"
        ],
        "title": "AuthStatusResponse"
      },

      "Body_create_evaluation_v1_evaluations_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Image or video file to evaluate"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_create_evaluation_v1_evaluations_post"
      },

      "Body_create_subjective_assessment_v1_subjective_assessments_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Image or video file to assess without persistence"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_create_subjective_assessment_v1_subjective_assessments_post"
      },

      "Body_create_visualization_v1_visualizations_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Image file to visualize"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_create_visualization_v1_visualizations_post"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "example": {
          "error": "Model 'iqa' is not loaded"
        }
      },
      "EvaluationResponse": {
        "properties": {
          "evaluation_id": {
            "type": "string",
            "title": "Evaluation Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "task_type": {
            "type": "string",
            "title": "Task Type"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "backbone": {
            "type": "string",
            "title": "Backbone"
          },
          "dataset": {
            "type": "string",
            "title": "Dataset"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Normalized predicted quality score"
          },
          "mos_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mos Score",
            "description": "Score converted to dataset MOS range"
          },
          "mos_min": {
            "type": "number",
            "title": "Mos Min"
          },
          "mos_max": {
            "type": "number",
            "title": "Mos Max"
          },
          "media_size": {
            "type": "string",
            "title": "Media Size"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          }
        },
        "type": "object",
        "required": [
          "evaluation_id",
          "filename",
          "model_id",
          "media_type",
          "task_type",
          "model_name",
          "backbone",
          "dataset",
          "score",
          "mos_score",
          "mos_min",
          "mos_max",
          "media_size",
          "latency_ms"
        ],
        "title": "EvaluationResponse"
      },

      "FrontendEvaluationLogResponse": {
        "properties": {
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Items"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "items",
          "count"
        ],
        "title": "FrontendEvaluationLogResponse",
        "description": "Frontend evaluation records read from the SQLite evaluation store."
      },

      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "loaded_models": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Loaded Models"
          },
          "device": {
            "type": "string",
            "title": "Device"
          }
        },
        "type": "object",
        "required": [
          "status",
          "loaded_models",
          "device"
        ],
        "title": "HealthResponse"
      },

      "LoginRequest": {
        "properties": {
          "api_key": {
            "type": "string",
            "title": "Api Key"
          }
        },
        "type": "object",
        "required": [
          "api_key"
        ],
        "title": "LoginRequest"
      },

      "ModelCollectionResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ModelSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "items",
          "count"
        ],
        "title": "ModelCollectionResponse"
      },
      "ModelSummary": {
        "properties": {
          "model_id": {
            "type": "string",
            "title": "Model Id",
            "description": "Serving role: iqa or vqa"
          },
          "task_type": {
            "type": "string",
            "title": "Task Type"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "backbone": {
            "type": "string",
            "title": "Backbone"
          },
          "dataset": {
            "type": "string",
            "title": "Dataset"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "mos_min": {
            "type": "number",
            "title": "Mos Min"
          },
          "mos_max": {
            "type": "number",
            "title": "Mos Max"
          },
          "checkpoint": {
            "type": "string",
            "title": "Checkpoint"
          }
        },
        "type": "object",
        "required": [
          "model_id",
          "task_type",
          "model_name",
          "backbone",
          "dataset",
          "media_type",
          "mos_min",
          "mos_max",
          "checkpoint"
        ],
        "title": "ModelSummary"
      },

      "SubjectiveAssessmentResponse": {
        "properties": {
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "llm_score": {
            "type": "integer",
            "title": "Llm Score",
            "description": "Ollama subjective visual-quality score in [0, 100]"
          },
          "bayesian_score": {
            "type": "number",
            "title": "Bayesian Score",
            "description": "Beta-prior posterior mean in [0, 100]"
          },
          "credible_interval": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Credible Interval",
            "description": "Approximate 95% Bayesian credible interval"
          },
          "model_used": {
            "type": "string",
            "title": "Model Used"
          },
          "frames_sampled": {
            "type": "integer",
            "title": "Frames Sampled"
          }
        },
        "type": "object",
        "required": [
          "media_type",
          "description",
          "llm_score",
          "bayesian_score",
          "credible_interval",
          "model_used",
          "frames_sampled"
        ],
        "title": "SubjectiveAssessmentResponse",
        "description": "Ephemeral Ollama-based quality description and Bayesian assessment."
      },

      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VisualizationResponse": {
        "properties": {
          "visualization_id": {
            "type": "string",
            "title": "Visualization Id"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "layers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Layers"
          },
          "feature_maps": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Feature Maps"
          },
          "gradcam": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gradcam"
          }
        },
        "type": "object",
        "required": [
          "visualization_id",
          "model_id",
          "filename",
          "score",
          "layers",
          "feature_maps"
        ],
        "title": "VisualizationResponse"
      }
    }
  }
}
