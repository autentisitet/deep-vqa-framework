    "/v1/visualizations": {
      "post": {
        "tags": [
          "visualizations"
        ],
        "summary": "Generate feature maps and Grad-CAM for an image",
        "description": "Generate feature maps and a Grad-CAM overlay for an uploaded image.\n\nThe produced PNG files are written under an unguessable directory, tagged\nwith the caller's session owner, and only served back to that owner. The\nimage backbone must produce a differentiable spatial CAM for Grad-CAM.",
        "operationId": "create_visualization_v1_visualizations_post",
        "parameters": [
          {
            "name": "model_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Image model identifier",
              "default": "iqa",
