# Host/container connection settings only. Copy to .env and adjust as needed.
# Shared model/limit defaults live in deploy-config/basic.yaml; authentication
# and history overrides live in deploy-config/profiles/*.yaml (internal,
# proxy, local). Machine-specific values stay in this file.

API_HOST=0.0.0.0
API_BIND_HOST=127.0.0.1
API_PORT=8001
API_INTERNAL_PORT=8000

WEB_HOST=127.0.0.1
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8000
WEB_INTERNAL_PORT=80

DEEP_VQA_DEPLOYMENT_CONFIG=deploy-config/profiles/infer_deploy.internal.yaml

# Optional path overrides. Defaults are container-friendly and relative to the
# project root: uploads/ for incoming media, and the SQLite file below for
# internal-mode evaluation history.
# DEEP_VQA_UPLOAD_DIR=uploads
# DEEP_VQA_SQLITE_PATH=reports/frontend-evaluations.sqlite3
# DEEP_VQA_ACCOUNTS_SQLITE_PATH=reports/accounts.sqlite3

# Only used by the legacy auth.mode: api_key deployment. Internal mode uses
# auth.mode: accounts, where visitors register in the browser instead.
# Keep this secret out of Git and out of the frontend source.
DEEP_VQA_API_KEY=
# Used to sign the HttpOnly login cookie. Generate independently from the API key.
DEEP_VQA_AUTH_SECRET=

# Host-side credentials used only by `make docker-memory-measure`
# (scripts/measure_container_memory.py). Internal mode authenticates with
# email + password; the legacy api_key mode reuses DEEP_VQA_API_KEY instead.
# DEEP_VQA_EMAIL=you@example.com
# DEEP_VQA_PASSWORD=
