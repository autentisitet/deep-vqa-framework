# Host/container connection settings only. Copy to .env and adjust as needed.
# Stable serving policy (auth mode, Ollama model, upload and SQLite limits)
# lives in deploy-config/profiles/infer_deploy.internal.yaml or deploy-config/profiles/infer_deploy.public.yaml
# and is selected by the profile Make target; it is not duplicated here.
PROJECT_NAME=deep-vqa

API_HOST=0.0.0.0
API_BIND_HOST=127.0.0.1
API_PORT=8001
API_INTERNAL_PORT=8000

WEB_HOST=127.0.0.1
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8000
WEB_INTERNAL_PORT=80

OLLAMA_HOST=127.0.0.1
OLLAMA_BIND_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEEP_VQA_DEPLOYMENT_CONFIG=deploy-config/profiles/infer_deploy.internal.yaml
# Optional proxy reachable from inside the Ollama container. For Podman use
# host.containers.internal instead of a host loopback address.
OLLAMA_HTTP_PROXY=
OLLAMA_HTTPS_PROXY=

# Optional path override for the frontend evaluation database.
DEEP_VQA_SQLITE_PATH=reports/frontend-evaluations.sqlite3

# Set auth.mode: api_key in the selected deployment profile YAML for internal deployments.
# Keep this secret out of Git and out of the frontend source.
DEEP_VQA_API_KEY=
# Used to sign the HttpOnly login cookie. Generate independently from the API key.
DEEP_VQA_AUTH_SECRET=
